{
  "spec": {
    "name": "wp-request-form",
    "region": "nyc",
    "services": [
      {
        "name": "web",
        "github": {
          "repo": "maxdevs97/wp-request-form",
          "branch": "main",
          "deploy_on_push": true
        },
        "build_command": "npm install",
        "run_command": "npm start",
        "environment_slug": "node-js",
        "instance_count": 1,
        "instance_size_slug": "basic-xxs",
        "http_port": 8080,
        "routes": [
          {
            "path": "/"
          }
        ],
        "health_check": {
          "http_path": "/health",
          "initial_delay_seconds": 10,
          "period_seconds": 10,
          "timeout_seconds": 3,
          "success_threshold": 1,
          "failure_threshold": 3
        }
      }
    ]
  }
}
